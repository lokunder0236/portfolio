rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidAnalyticsDoc(data) {
      return data.keys().hasOnly(['total', 'es', 'ca', 'en'])
        && data.total is int && data.es is int
        && data.ca is int && data.en is int
        && data.total >= 0 && data.es >= 0 && data.ca >= 0 && data.en >= 0
        && data.total <= 10000000
        && data.total == data.es + data.ca + data.en;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow create, update: if docId in ['pati', 'nova', 'repx', 'pilates', 'contact']
                             && isValidAnalyticsDoc(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
