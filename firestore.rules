rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Writes use a merge() with increment(), so on a brand-new document
    // the very first write may only carry 2 of the 4 fields (total +
    // whichever language). request.resource.data reflects that partial
    // merged result, so fields are read with a default via get() instead
    // of assuming they exist.
    function isValidAnalyticsDoc(data) {
      return data.keys().hasOnly(['total', 'es', 'ca', 'en'])
        && data.get('total', 0) is int && data.get('es', 0) is int
        && data.get('ca', 0) is int && data.get('en', 0) is int
        && data.get('total', 0) >= 0 && data.get('es', 0) >= 0
        && data.get('ca', 0) >= 0 && data.get('en', 0) >= 0
        && data.get('total', 0) <= 10000000
        && data.get('total', 0) == data.get('es', 0) + data.get('ca', 0) + data.get('en', 0);
    }

    match /analytics/{docId} {
      // Writes stay public — every visitor's click needs to land here
      // with no login. Reads are restricted to the admin account so the
      // aggregated numbers aren't just publicly listable by anyone.
      allow read: if request.auth != null
                  && request.auth.uid == 'EbXfrKVN62X27DULcBXybjpwHYw2';
      allow create, update: if docId in ['pati', 'nova', 'repx', 'pilates', 'contact']
                             && isValidAnalyticsDoc(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
